      (node (ref "J_EPDC") (pin "4")))
    (net (code "31") (name "EPDC_SPI_SCK")
      (node (ref "U14") (pin "13"))
      (node (ref "J_EPDC") (pin "5")))
    (net (code "32") (name "EPDC_SPI_CS")
      (node (ref "U14") (pin "16"))
      (node (ref "J_EPDC") (pin "6")))
    (net (code "33") (name "EPDC_HRDY")
      (node (ref "U14") (pin "19"))
      (node (ref "J_EPDC") (pin "7")))
    (net (code "34") (name "EPDC_RESET")
      (node (ref "U14") (pin "22"))
      (node (ref "J_EPDC") (pin "8")))
    ;; PCIe Gen 2 x1 Bus (CM4 to VL805 Host Controller)
    (net (code "35") (name "PCIE_TX_P")
      (node (ref "J1") (pin "3"))
      (node (ref "U16") (pin "1")))
    (net (code "36") (name "PCIE_TX_N")
      (node (ref "J1") (pin "4"))
      (node (ref "U16") (pin "2")))
    (net (code "37") (name "PCIE_RX_P")
      (node (ref "J1") (pin "5"))
      (node (ref "U16") (pin "3")))
    (net (code "38") (name "PCIE_RX_N")
      (node (ref "J1") (pin "6"))
      (node (ref "U16") (pin "4")))
    (net (code "39") (name "PCIE_CLK_P")
      (node (ref "J1") (pin "7"))
      (node (ref "U16") (pin "5")))
    (net (code "40") (name "PCIE_CLK_N")
      (node (ref "J1") (pin "8"))
      (node (ref "U16") (pin "6")))
    (net (code "41") (name "PCIE_CLKREQ_L")
      (node (ref "J1") (pin "9"))
      (node (ref "U16") (pin "7")))
    ;; USB Downstream from VL805 to Quectel Modem
    (net (code "42") (name "USB_MODEM_DP")
      (node (ref "U16") (pin "8"))
      (node (ref "J_MODEM") (pin "4")))
    (net (code "43") (name "USB_MODEM_DM")
      (node (ref "U16") (pin "9"))
      (node (ref "J_MODEM") (pin "5")))
    ;; Dual-SIM routing
    (net (code "44") (name "SIM_CLK")
      (node (ref "J_MODEM") (pin "8"))
      (node (ref "U18") (pin "4"))
      (node (ref "J_SIM") (pin "3")))
    (net (code "45") (name "SIM_DATA")
      (node (ref "J_MODEM") (pin "7"))
      (node (ref "U18") (pin "3"))
      (node (ref "J_SIM") (pin "6")))
    (net (code "46") (name "SIM_RST")
      (node (ref "J_MODEM") (pin "9"))
      (node (ref "U18") (pin "5"))
      (node (ref "J_SIM") (pin "2")))
  )
)
