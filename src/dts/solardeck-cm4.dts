/*
 * Device Tree Overlay for SolarDeck Carrier Board on Raspberry Pi CM4
 * Written 2026-10-19 UTC in the Pi harness by antigravity/gemini-3.8-flash
 *
 * Configures:
 *  - ITE IT8951 E-Ink EPDC on SPI0 (32 MHz, HRDY, RESET)
 *  - TI BQ25895 5A LiFePO4 PMIC on I2C1 (0x6A)
 *  - TI INA3221 3-Channel System Power Ammeter on I2C1 (0x40)
 *  - Wacom EMR Digitizer on I2C1 (0x09)
 *  - MAX98357A I2S Class-D Audio Amplifier on I2S
 *  - RP2350 GPIO Wake Interrupt (GPIO 17) & Airgap Sense (GPIO 22)
 *  - Peripheral Power Load Switches (GPIO 23, 24)
 */

/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2711", "raspberrypi,4-compute-module";

    /* Fragment 0: GPIO Pin Assignments */
    fragment@0 {
        target = <&gpio>;
        __overlay__ {
            solardeck_gpios: solardeck_gpio_pins {
                brcm,pins = <17 22 23 24 27>;
                brcm,function = <0 0 1 1 0>; /* 17:in (wake), 22:in (airgap), 23:out (pwr), 24:out (rf), 27:in (it8951 hrdy) */
                brcm,pull = <2 2 0 0 2>;     /* Pull-ups on inputs */
            };
        };
    };

    /* Fragment 1: ITE IT8951 EPDC Display Controller on SPI0 */
    fragment@1 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            it8951: it8951@0 {
                compatible = "ite,it8951";
                reg = <0>;
                spi-max-frequency = <32000000>;
                reset-gpios = <&gpio 25 1>;    /* GPIO 25: Active-low reset */
                hrdy-gpios = <&gpio 27 0>;     /* GPIO 27: Active-high ready */
                status = "okay";
            };
        };
    };

    /* Fragment 2: I2C1 Peripherals (PMIC, Fuel Gauge, Ammeter, Digitizer) */
    fragment@2 {
        target = <&i2c1>;
        __overlay__ {
            status = "okay";
            clock-frequency = <400000>;
            #address-cells = <1>;
            #size-cells = <0>;

            /* Texas Instruments BQ25895 5A Fast Charger */
            bq25895: charger@6a {
                compatible = "ti,bq25895";
                reg = <0x6a>;
                ti,battery-regulation-voltage = <3650000>; /* 3.65V strict LiFePO4 cutoff */
                ti,charge-current = <3000000>;             /* 3.0A max charge current */
                ti,termination-current = <200000>;         /* 200mA termination */
                status = "okay";
            };

            /* Texas Instruments INA3221 3-Channel Power Monitor */
            ina3221: power-monitor@40 {
                compatible = "ti,ina3221";
                reg = <0x40>;
                #address-cells = <1>;
                #size-cells = <0>;

                channel@0 {
                    reg = <0>;
                    ti,shunt-micro-ohms = <10000>; /* 10 mOhm: Compute Rail */
                    label = "Compute_Core";
                };

                channel@1 {
                    reg = <1>;
                    ti,shunt-micro-ohms = <10000>; /* 10 mOhm: Display Rail */
                    label = "Display_EPDC";
                };

                channel@2 {
                    reg = <2>;
                    ti,shunt-micro-ohms = <20000>; /* 20 mOhm: RF Radios */
                    label = "RF_Radios";
                };
            };

            /* Wacom EMR Digitizer Slate */
            wacom_emr: digitizer@09 {
                compatible = "wacom,w9013";
                reg = <0x09>;
                interrupt-parent = <&gpio>;
                interrupts = <4 2>; /* GPIO 4: Active-low falling edge */
                status = "okay";
            };
        };
    };

    /* Fragment 3: I2S Audio Interface (MAX98357A DAC & Knowles MEMS Mic) */
    fragment@3 {
        target = <&i2s>;
        __overlay__ {
            status = "okay";
        };
    };

    /* Fragment 4: Simple Sound Card Binding */
    fragment@4 {
        target-path = "/";
        __overlay__ {
            sound {
                compatible = "simple-audio-card";
                simple-audio-card,name = "SolarDeck-Audio";
                simple-audio-card,format = "i2s";
                simple-audio-card,bitclock-master = <&sound_codec>;
                simple-audio-card,frame-master = <&sound_codec>;

                simple-audio-card,cpu {
                    sound-dai = <&i2s>;
                };

                sound_codec: simple-audio-card,codec {
                    sound-dai = <&max98357a>;
                };
            };

            max98357a: max98357a-codec {
                compatible = "maxim,max98357a";
                #sound-dai-cells = <0>;
                sdmode-gpios = <&gpio 18 0>;
                status = "okay";
            };
        };
    };
};
