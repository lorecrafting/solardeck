// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Device Tree Overlay for SolarDeck Carrier Board on Raspberry Pi CM5
 * Written 2026-10-19 UTC in the Pi harness by antigravity/gemini-3.8-flash
 * Revised 2026-10-21 UTC in Claude Code by anthropic/claude-opus-5-5 (ADR-031, ADR-032)
 *
 * NOT YET VALID FOR CM5. This overlay was written for the CM4 (BCM2711). On the CM5, GPIO, SPI, I2C
 * and I2S are provided by the RP1 I/O controller, so the brcm,pins pinctrl below and the target
 * labels must be ported to the CM5/RP1 base tree before it is compiled. Known defects to fix in the
 * same pass: AUDIT 6 H11 (audio clock master, SD_MODE on PCM_CLK).
 * The display controller node is deliberately absent: the Kaleido 4 controller is TBD (ADR-032).
 *
 * Configures:
 *  - TI INA3221 3-Channel System Power Ammeter on I2C1 (0x40)
 *  - Wacom EMR Digitizer on I2C1 (0x09)
 *  - MAX98357A I2S Class-D Audio Amplifier on I2S
 *  - RP2350 GPIO Wake Interrupt (GPIO 17) & Airgap Sense (GPIO 22)
 *  - Peripheral Power Load Switches (GPIO 23, 24)
 */

/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2712";

    /* Fragment 0: GPIO Pin Assignments */
    fragment@0 {
        target = <&gpio>;
        __overlay__ {
            solardeck_gpios: solardeck_gpio_pins {
                brcm,pins = <17 22 23 24 27>;
                brcm,function = <0 0 1 1 0>; /* 17:in (wake), 22:in (airgap), 23:out (pwr), 24:out (rf), 27:in (display ready, TBD) */
                brcm,pull = <2 2 0 0 2>;     /* Pull-ups on inputs */
            };
        };
    };

    /* Fragment 1: display controller on SPI0 -- TBD with the Kaleido 4 datasheet (ADR-032). */

    /* Fragment 2: I2C1 Peripherals (PMIC, Fuel Gauge, Ammeter, Digitizer) */
    fragment@2 {
        target = <&i2c1>;
        __overlay__ {
            status = "okay";
            clock-frequency = <400000>;
            #address-cells = <1>;
            #size-cells = <0>;

            /* No charger node: the BQ25798 is on the RP2350's always-on bus and Linux never binds or
             * writes it (ADR-035). Charge state reaches Linux through the RP2350 telemetry bridge. */

            /* Texas Instruments INA3221 3-Channel Power Monitor */
            ina3221: power-monitor@40 {
                compatible = "ti,ina3221";
                reg = <0x40>;
                #address-cells = <1>;
                #size-cells = <0>;

                channel@0 {
                    reg = <0>;
                    ti,shunt-micro-ohms = <10000>; /* 10 mOhm: Compute Rail */
                    label = "Compute_Core";
                };

                channel@1 {
                    reg = <1>;
                    ti,shunt-micro-ohms = <10000>; /* 10 mOhm: Display Rail */
                    label = "Display_EPDC";
                };

                channel@2 {
                    reg = <2>;
                    ti,shunt-micro-ohms = <20000>; /* 20 mOhm: RF Radios */
                    label = "RF_Radios";
                };
            };

            /* Wacom EMR Digitizer Slate */
            wacom_emr: digitizer@09 {
                compatible = "wacom,w9013";
                reg = <0x09>;
                interrupt-parent = <&gpio>;
                interrupts = <4 2>; /* GPIO 4: Active-low falling edge */
                status = "okay";
            };
        };
    };

    /* Fragment 3: I2S Audio Interface (MAX98357A DAC & Knowles MEMS Mic) */
    fragment@3 {
        target = <&i2s>;
        __overlay__ {
            status = "okay";
        };
    };

    /* Fragment 4: Simple Sound Card Binding */
    fragment@4 {
        target-path = "/";
        __overlay__ {
            sound {
                compatible = "simple-audio-card";
                simple-audio-card,name = "SolarDeck-Audio";
                simple-audio-card,format = "i2s";
                simple-audio-card,bitclock-master = <&sound_codec>;
                simple-audio-card,frame-master = <&sound_codec>;

                simple-audio-card,cpu {
                    sound-dai = <&i2s>;
                };

                sound_codec: simple-audio-card,codec {
                    sound-dai = <&max98357a>;
                };
            };

            max98357a: max98357a-codec {
                compatible = "maxim,max98357a";
                #sound-dai-cells = <0>;
                sdmode-gpios = <&gpio 18 0>;
                status = "okay";
            };
        };
    };
};
