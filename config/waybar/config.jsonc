{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["custom/solar", "custom/airgap", "battery", "temperature"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M UTC}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/solar": {
        "format": "☀ {text} lx",
        "interval": 2,
        "exec": "cat /run/solardeck/telemetry.json | grep -o '\"solar_lux\": [0-9]*' | awk '{print $2}'",
        "return-type": "text"
    },

    "custom/airgap": {
        "format": "⚡ AIRGAP",
        "interval": 2,
        "exec": "grep -q '\"airgap_active\": true' /run/solardeck/telemetry.json && echo '🔒 AIRGAP' || echo ''",
        "return-type": "text"
    },

    "battery": {
        "states": {
            "good": 80,
            "warning": 25,
            "critical": 10
        },
        "format": "BAT {capacity}% ({power:.1f}W)",
        "format-charging": "CHG {capacity}% (+{power:.1f}W)",
        "format-plugged": "PLUG {capacity}%"
    },

    "temperature": {
        "critical-threshold": 60,
        "format": "{temperatureC}°C"
    }
}
